# Copy to /etc/nimikh/backup.env, chmod 600, root-owned. Loaded by backup.sh and restore-drill.sh via: BACKUP_ENV_FILE (default /etc/nimikh/backup.env)
# --- Database (required) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=backup
DB_PASSWORD=change-me
TABLE_PREFIX=wp_
# --- Files ---
UPLOADS_DIR=/var/www/site/wp-content/uploads
# --- Local staging and retention ---
BACKUP_DIR=/var/backups/nimikh
LOCAL_RETENTION_DAYS=3
REMOTE_RETENTION_DAYS=30
# --- Off-site (rclone). Remote is configured by env, no rclone.conf needed. Example for Cloudflare R2: ---
RCLONE_REMOTE=nimikhbackup:nimikh-backups/prod
RCLONE_CONFIG_NIMIKHBACKUP_TYPE=s3
RCLONE_CONFIG_NIMIKHBACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_NIMIKHBACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_NIMIKHBACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_NIMIKHBACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# For AWS S3 instead: TYPE=s3, PROVIDER=AWS, REGION=ap-southeast-1 and no ENDPOINT.
# --- Optional encryption with age (https://age-encryption.org). Leave empty to store unencrypted (not recommended off-site). ---
# Public recipient is all the server needs; keep the private identity OFF the server and use it for restores/drills.
BACKUP_AGE_RECIPIENT=
# Used by restore-drill.sh only, needs to be readable on the drill host:
BACKUP_AGE_IDENTITY_FILE=
# --- Drill ---
DRILL_DB_NAME=nimikh_restore_drill
DRILL_DB_USER=
DRILL_DB_PASSWORD=
DRILL_DB_HOST=
# --- Optional dead-man's-switch pings (healthchecks.io / Better Stack heartbeat). Appended with /fail on failure. ---
BACKUP_PING_URL=
DRILL_PING_URL=
